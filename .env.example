# ============================================================
# 全部可用环境变量参考（复制为 .env 后按需修改）
# 凡标注「可选」者留空即关闭对应功能
# ============================================================

# 站点信息
VITE_SITE_NAME = "Quisperの主页" # 名称（浏览器标题）
VITE_SITE_AUTHOR = "Quisper" # 作者（页脚 © 与链接）
VITE_SITE_KEYWORDS = "Quisper,个人主页" # SEO 关键词
VITE_SITE_DES = "Quisper 的个人主页" # SEO 简介
VITE_SITE_URL = "civer.cn" # 站点地址（页脚作者链接）
VITE_SITE_MAIN_LOGO = "/images/avatar.jpg" # 头像（建议本地资产，避免外链失效）

# 简介文本（显示在问候语下方）
VITE_DESC_TEXT = "写代码、记生活，在互联网角落慢慢搭建的小站"

# 网站图标（favicon / ico）
VITE_SITE_ICO = "https://buc.civer.cn/ico/origin.ico" # 传统 .ico
VITE_SITE_ICO_SVG = "https://buc.civer.cn/ico/origin.svg" # SVG 图标
VITE_SITE_ICO_LIGHT = "https://buc.civer.cn/ico/origin-light.png" # 浅色模式 PNG
VITE_SITE_ICO_DARK = "https://buc.civer.cn/ico/origin-dark.png" # 深色模式 PNG
VITE_SITE_ICO_APPLE = "https://buc.civer.cn/ico/origin.png" # Apple touch 图标

# 天气 Key（可选）
## 高德开放平台 Web服务 Key（非 Web端 JS API），免费每日上限 5000 次
## 留空则回退公共 API https://api.oioweb.cn/doc/weather/GetWeather
# VITE_WEATHER_KEY = ""

# 建站日期（可选；留空不显示运行时长）格式 YYYY-MM-DD 或仅年份 YYYY
VITE_SITE_START = "2025-7-20"

# 博客联动（可选；Firefly 博客地址，用于最新文章卡片与「博客」壁纸/主题色同步）
VITE_BLOG_URL = "https://blog.civer.cn"

# 今日热榜（可选；自建 NewsNow 实例地址，留空隐藏热榜卡片）
# VITE_HOT_API_BASE = "https://hot.civer.cn"

# 备案信息（可选；留空不显示）
VITE_SITE_ICP = "渝ICP备2026020534号" # ICP 备案号
VITE_SITE_GA = "渝公网安备50019002505695号" # 公安备案号
VITE_SITE_GA_CODE = 50019002505695 # 公安备案查询码（纯数字）

# 社交 / 站点链接不走环境变量：
## 见 src/data/socialLinks.json 与 src/data/siteLinks.json
## 站点图标名称见 src/components/Icon.vue 中的 paths